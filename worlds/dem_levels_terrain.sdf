<?xml version="1.0"?>
<sdf version="1.10">
  <world name="dem_levels_terrain">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 -70 45 0 0.6 1.5708</camera_pose>
      </plugin>
    </gui> -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <name>dem_level_desert</name>
      <uri>model://dem_level_desert</uri>
      <pose>-25 0 0 0 0 0</pose>
    </include>
    <include>
      <name>dem_level_soil</name>
      <uri>model://dem_level_soil</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <name>dem_level_rocks</name>
      <uri>model://dem_level_rocks</uri>
      <pose>-25 -25 0 0 0 0</pose>
    </include>
    <include>
      <name>dem_level_water</name>
      <uri>model://dem_level_water</uri>
      <pose>0 -25 0 0 0 0</pose>
    </include>

    <include>
      <name>dem_level_vehicle</name>
      <uri>model://dem_level_vehicle</uri>
      <pose>-12.5 12.5 3.0 0 0 0</pose>
    </include>

    <plugin name="gz::sim" filename="dummy">
      <performer name="dem_vehicle_performer">
        <ref>dem_level_vehicle</ref>
        <geometry>
          <box>
            <size>1.4 1.0 1.0</size>
          </box>
        </geometry>
      </performer>

      <level name="level_desert">
        <pose>-12.5 12.5 5 0 0 0</pose>
        <geometry>
          <box>
            <size>25 25 14</size>
          </box>
        </geometry>
        <buffer>5</buffer>
        <ref>dem_level_desert</ref>
      </level>

      <level name="level_soil">
        <pose>12.5 12.5 5 0 0 0</pose>
        <geometry>
          <box>
            <size>25 25 14</size>
          </box>
        </geometry>
        <buffer>5</buffer>
        <ref>dem_level_soil</ref>
      </level>

      <level name="level_rocks">
        <pose>-12.5 -12.5 5 0 0 0</pose>
        <geometry>
          <box>
            <size>25 25 14</size>
          </box>
        </geometry>
        <buffer>5</buffer>
        <ref>dem_level_rocks</ref>
      </level>

      <level name="level_water">
        <pose>12.5 -12.5 5 0 0 0</pose>
        <geometry>
          <box>
            <size>25 25 14</size>
          </box>
        </geometry>
        <buffer>5</buffer>
        <ref>dem_level_water</ref>
      </level>
    </plugin>
  
  </world>
</sdf>
